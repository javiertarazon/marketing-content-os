# Do not expose API, PostgreSQL, or Redis directly to the internet.
# Put the API behind an HTTPS reverse proxy and configure CORS to its origin.
DOMAIN=content.example.com
API_BASE_URL=https://content.example.com
POSTGRES_USER=content
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=content
WORKER_API_TOKEN=replace-with-a-different-long-random-token
DATABASE_URL=postgresql://content:replace-with-a-long-random-password@postgres:5432/content
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=https://content.example.com
