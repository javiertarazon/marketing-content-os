# Local development only. Replace every value before exposing services publicly.
POSTGRES_USER=content
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=content
DATABASE_URL=postgresql://content:change-this-local-password@postgres:5432/content
REDIS_URL=redis://redis:6379/0
WORKER_API_TOKEN=replace-with-a-long-random-token
CORS_ORIGINS=http://localhost:3001,http://localhost:3000

# Keep the Space private; use a read-only Hugging Face token.
VOICE_STUDIO_URL=https://SU-USUARIO-voice-studio-agent.hf.space
HF_TOKEN=

# Optional publishing integration. Keep credentials out of source control.
# Postiz Cloud. For self-hosting, use its /api/public/v1 base path.
POSTIZ_BASE_URL=https://api.postiz.com/public/v1
POSTIZ_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
META_APP_ID=
META_APP_SECRET=

# Configure this only after setting up an S3-compatible storage provider.
STORAGE_PUBLIC_BASE_URL=
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
