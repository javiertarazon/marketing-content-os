# Local development only. Replace every value before exposing services publicly.
POSTGRES_USER=content
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=content
DATABASE_URL=postgresql://content:change-this-local-password@postgres:5432/content
REDIS_URL=redis://redis:6379/0
WORKER_API_TOKEN=replace-with-a-long-random-token
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Public HTTPS URL of the API, reachable from Colab.
# Required by the workers (notebooks); optional for the API itself.
API_BASE_URL=https://api.example.com

# Keep the Space private; use a read-only Hugging Face token.
VOICE_STUDIO_URL=https://javiertarazon-voice-studio-agent.hf.space
HF_TOKEN=
SCRIPT_SPACE_URL=https://javiertarazon-marketing-script-generator.hf.space

# Optional publishing integration with a self-hosted Mixpost Lite.
# MIXPOST_BASE_URL: REST API base. Lite serves the API under the "mixpost"
# core path, so it ends in /mixpost/api. From inside the Docker network use
# http://mixpost/mixpost/api (the compose overrides it for the publisher).
# MIXPOST_API_KEY: PERSONAL key created in the "API" page of the Mixpost
# dashboard. It is NOT MIXPOST_APP_KEY (Laravel app key, used only by the
# Mixpost container itself).
MIXPOST_BASE_URL=http://localhost:3002/mixpost/api
MIXPOST_API_KEY=
# Optional: UUID of the workspace. Empty = resolve the first one of the token.
MIXPOST_WORKSPACE_UUID=
# IANA timezone used to schedule posts.
MIXPOST_TIMEZONE=America/Caracas
MIXPOST_URL=http://localhost:3002
NEXT_PUBLIC_MIXPOST_URL=http://localhost:3002/mixpost
MIXPOST_DOMAIN=localhost:3002
MIXPOST_APP_KEY=base64:REPLACE_WITH_RANDOM_32_BYTE_BASE64_KEY
MIXPOST_DB_NAME=mixpost
MIXPOST_DB_USER=mixpost
MIXPOST_DB_PASSWORD=replace-with-a-long-random-password
MIXPOST_DB_ROOT_PASSWORD=replace-with-a-different-long-random-password
MIXPOST_CORE_PATH=mixpost

YOUTUBE_API_KEY=
YOUTUBE_REGION_CODE=VE

# Configure this only after setting up an S3-compatible storage provider.
# STORAGE_PUBLIC_BASE_URL must point to the public host of the same bucket:
# the publisher only accepts videos served from that host.
STORAGE_PUBLIC_BASE_URL=
S3_ENDPOINT_URL=https://REPLACE_ME.r2.cloudflarestorage.com
S3_BUCKET=replace-with-your-bucket
S3_ACCESS_KEY_ID=replace-with-your-access-key
S3_SECRET_ACCESS_KEY=replace-with-your-secret-key
