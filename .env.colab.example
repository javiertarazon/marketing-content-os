# Plantilla local para configurar Secrets de los workers en Google Colab.
# No guardes valores reales en este archivo ni lo subas a Drive o Git.
# Colab no importa este archivo automaticamente: copia cada valor a Secrets.

# URL HTTPS del Quick Tunnel activo; cambia al reiniciar el tunel.
API_BASE_URL=

# WORKER_API_TOKEN de tu .env local.
WORKER_API_TOKEN=

# URLs de los Spaces privados de Hugging Face.
SCRIPT_SPACE_URL=https://javiertarazon-marketing-script-generator.hf.space
VOICE_STUDIO_URL=https://javiertarazon-voice-studio-agent.hf.space

# Token Hugging Face de solo lectura con acceso a ambos Spaces.
HF_TOKEN=

# Credenciales S3 de Cloudflare R2, limitadas al bucket privado.
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
